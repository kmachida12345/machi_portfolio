# macOS
.DS_Store

# 環境変数・秘密情報（どの階層でも除外）
.env
.env.*
!.env.example

# エディタ・ツールのローカル設定
.vscode/*
!.vscode/extensions.json
.idea/
.claude/

# 依存ライブラリ・ビルド成果物（どの階層でも除外）
node_modules/
.next/

# ルート直下のローカル専用ツール（Prettier を手動実行するためだけに入れたもの）
/package.json
/package-lock.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

/docs/*